# ============================================================================
# Hugging Face Hub Configuration
# ============================================================================

# DEFAULT FOR STUDENTS: No action needed!
# Pre-trained models will automatically download from gperdrizet/CIFAR10
# when you set retrain_model=False and model_source='huggingface' in notebooks.
#
# The default repository below contains all trained models from the tutorial.
# You can use them without creating a .env file or HuggingFace account.
HF_REPO_ID=gperdrizet/CIFAR10

# ============================================================================
# Optional: Upload your own models
# ============================================================================
# 
# If you want to train and upload models to your own Hugging Face repository:
#
# 1. Create a Hugging Face account at https://huggingface.co/join
# 2. Create a new model repository at https://huggingface.co/new
# 3. Get your access token from https://huggingface.co/settings/tokens
# 4. Copy this file to .env: cp .env.template .env
# 5. Update HF_REPO_ID below with your username/repo-name
# 6. Add your token below (keep this file secret - it's in .gitignore)
# 7. Run: huggingface-cli login (paste your token when prompted)
#
# Example:
# HF_REPO_ID=your-username/your-cifar10-models
# HF_TOKEN=hf_xxxxxxxxxxxxxxxxxxxxxxxxxxxxx
#
# Then in notebooks, set upload_to_hf=True to upload your trained models.
# ============================================================================

# Your Hugging Face access token (optional - only needed for uploading)
# Never commit this file with your real token! Use .env instead.
# HF_TOKEN=
